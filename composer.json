{
    "name": "your-name/kanban-tracker",
    "description": "Kanban task tracker with RoadRunner",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "spiral/roadrunner": "^2024",
        "spiral/roadrunner-cli": "^2.0",
        "nyholm/psr7": "^1.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}